{
    "name": "leaf-ng",
    "version": "1.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "deploy": "ng deploy --base-href=/leaf_ng/",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\""
    },
    "prettier": {
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^21.2.5",
        "@angular/compiler": "^21.2.5",
        "@angular/core": "^21.2.5",
        "@angular/forms": "^21.2.5",
        "@angular/platform-browser": "^21.2.5",
        "@angular/router": "^21.2.5",
        "@angular/service-worker": "^21.2.5",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular-devkit/core": "^21.2.3",
        "@angular-devkit/schematics": "^21.2.3",
        "@angular/build": "^21.2.3",
        "@angular/cli": "^21.2.3",
        "@angular/compiler-cli": "^21.2.5",
        "@angular/language-server": "^22.2.1",
        "@schematics/angular": "^21.2.24",
        "angular-cli-ghpages": "^3.1.0",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0"
    }
}
